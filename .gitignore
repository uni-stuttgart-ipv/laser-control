# Only the app's source, tests, packaging and docs are tracked.
# Everything below is created on your machine and should stay there.

# ---- Claude Code (local assistant settings and notes) ----
.claude/
CLAUDE.md
CLAUDE.local.md
.mcp.json

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
*.egg

# ---- virtual environments ----
.venv/
venv/
env/

# ---- tests and code checkers ----
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---- build output (PyInstaller, Inno Setup) ----
build/
dist/
packaging/Output/

# ---- secrets and local settings ----
.env
.env.*

# ---- logs and temporary files ----
*.log
*.tmp
*.bak
*.orig
*.swp
*~

# ---- editors ----
.idea/
.vscode/

# ---- operating systems ----
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
